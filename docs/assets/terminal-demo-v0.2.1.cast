[32.732831, "o", "\r\nMake the one-second synthetic input longer so structured progress is visible.\r\n\r\n\u001b[1;36m$ ffmpeg -stream_loop 59 -i media/synthetic-input.mp4 -t 60 -c copy media/demo-input.mp4\u001b[0m\r\n"]
[36.823374, "o", "\r\n\u001b[1;36m$ demo-env/bin/pyffmpegcore profile run web/mp4-compatible --input media/demo-input.mp4 --output media/web.mp4 --explain\u001b[0m\r\n"]
