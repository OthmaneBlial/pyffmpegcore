[34.076993, "o", "\r\nMake the one-second synthetic input longer so structured progress is visible.\r\n\r\n\u001b[1;36m$ ffmpeg -stream_loop 59 -i media/synthetic-input.mp4 -t 60 -c copy media/demo-input.mp4\u001b[0m\r\n"]
